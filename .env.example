# Copy this file to .env (local), .env.dev, .env.uat, or .env.prod and fill
# in real values. These files are gitignored (except this .example) — never
# commit real credentials.
#
# This is the single credential format used by both the webapp/src connector
# AND Project/main.py's YAML-driven validation runner — no separate creds
# YAML files anymore. --environment local|dev|uat|prod picks which of these
# files gets loaded.

# ── AI backend (one of these) ────────────────────────────────────────────
DIAL_API_KEY=
DIAL_API_BASE=
DIAL_API_VERSION=
DIAL_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# ── Source connections — SRC_N_* (N = 1, 2, 3, ...), one block per source ──
# TYPE is one of: postgresql | mssql | athena

SRC_1_TYPE=postgresql
SRC_1_HOST=
SRC_1_PORT=5432
SRC_1_DATABASE=
SRC_1_SCHEMA=public
SRC_1_USERNAME=
SRC_1_PASSWORD=

SRC_2_TYPE=mssql
SRC_2_HOST=
SRC_2_PORT=1433
SRC_2_DATABASE=
SRC_2_SCHEMA=dbo
SRC_2_USERNAME=
SRC_2_PASSWORD=
SRC_2_AUTH=
# Optional — defaults to "ODBC Driver 18 for SQL Server" if omitted:
SRC_2_DRIVER=

SRC_3_TYPE=athena
SRC_3_REGION=us-west-2
SRC_3_DATABASE=
SRC_3_SCHEMA=
SRC_3_USERNAME=
SRC_3_PASSWORD=
SRC_3_QUERY_RESULT_LOCATION=s3://your-athena-query-results-bucket/

# ── Snowflake target ──────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# Optional — only needed if your user has no default warehouse:
SNOWFLAKE_WAREHOUSE=

# ── Jira (optional) — enables "Raise Jira ticket" in Review & Approve ────

JIRA_URL=https://abc.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=MAN
# Optional — defaults to "Task":
JIRA_ISSUE_TYPE=
